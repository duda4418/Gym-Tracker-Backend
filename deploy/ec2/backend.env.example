# Store the full contents of this file in either:
# - an SSM Parameter Store SecureString referenced by BACKEND_ENV_SSM_PARAMETER, or
# - a Secrets Manager secret referenced by BACKEND_ENV_SECRET_ID.
# The deployment workflow writes it atomically to /opt/gym-tracker/backend/backend.env on the EC2 instance.
# Use the hostname part of the Terraform RDS output as POSTGRES_HOST.
# Do not include :5432 in POSTGRES_HOST because POSTGRES_PORT is configured separately.

POSTGRES_USER=<replace-with-rds-username>
POSTGRES_PASSWORD=<replace-with-rds-password>
POSTGRES_DB=<replace-with-rds-database-name>
POSTGRES_HOST=gym-tracker-prod-postgres.cna4m8i443ki.eu-central-1.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_POOL_TIMEOUT_SECONDS=5
POLICY_EXPIRY_CHECK_INTERVAL_SECONDS=600

JWT_SECRET_KEY=<replace-with-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

OTEL_ENABLED=false
OTEL_SERVICE_NAME=gym-tracker-backend
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=production
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_EXPORTER_TIMEOUT_SECONDS=10
OTEL_TRACES_SAMPLER_RATIO=1.0

PYROSCOPE_ENABLED=false
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
PYROSCOPE_APPLICATION_NAME=gym-tracker-backend
PYROSCOPE_SAMPLE_RATE=100
PYROSCOPE_GIL_ONLY=true
PYROSCOPE_ENABLE_LOGGING=false

LOG_LEVEL=INFO
LOGS_DIR=app/logs
LOG_FILE_NAME=backend.log
UPLOADS_DIR=app/uploads

